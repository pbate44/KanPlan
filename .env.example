# Optional: copy this file to .env to override defaults.
# KanPlan runs without a .env file; every setting below has a sensible default.

# ── AI ───────────────────────────────────────────────────────────────────────
# KanPlan works with any OpenAI-compatible API. With nothing set here it uses
# Ollama (https://ollama.com) running on this machine, no key needed.

# OpenRouter (hosted models from many providers): just set your key.
# OPENROUTER_API_KEY=

# Any other OpenAI-compatible server, for example:
#   LM Studio  http://localhost:1234/v1
#   OpenAI     https://api.openai.com/v1   (needs AI_API_KEY)
# AI_BASE_URL=
# AI_API_KEY=

# Default model for users who haven't picked one in Settings → AI Model.
# Defaults to the first model the server lists (or Claude Haiku on OpenRouter).
# AI_MODEL=

# Model for background card summaries. Defaults to the chat model.
# AI_SUMMARY_MODEL=

# Optional: auto-generated and saved to .secret_key on first run if unset.
# SECRET_KEY=

# Optional: defaults to True for local use.
# DEBUG=True

# Optional: defaults to localhost,127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: folder for the database, uploads and generated secret key.
# Defaults to the project folder.
# DATA_DIR=/path/to/kanplan-data

# Optional: create this account automatically on first start if no accounts
# exist (used by Docker; the start scripts prompt instead).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=
